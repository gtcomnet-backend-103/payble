### API Configuration
@baseUrl = {{base_url}}
@apiKey = Bearer {{auth_token}}

#payment channel - card or bank_transfer
@channel = card

###
# @name Initialize Payment
# Create a new payment intent for a customer
POST {{baseUrl}}/api/payments
Authorization: {{apiKey}}
Content-Type: application/json
Accept: application/json

{
    "amount": 100000,
    "reference": "{{$random.alphanumeric(14)}}",
    "email": "customer@example.com",
    "currency": "NGN",
    "bearer": "account",
    "metadata": {
        "order_id": "12345"
    }
}

> {% client.global.set('reference', response.body.data.reference) %}
>>! {{$projectRoot}}/http/response/payment_request.json

###
# @name Authorize Payment
POST {{baseUrl}}/api/payments/{{reference}}/authorize
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json

{
    "channel": "{{channel}}",
    "card": {
        "number": "507850785078507804",
        "cvv": "884",
        "expiry_month": "02",
        "expiry_year": "27"
    }
}

> {% client.global.set('status', response.body.action || '') %}
>>! {{$projectRoot}}/http/response/payment_authorization_{{channel}}.json

###
# @name Validate Payment (OTP/PIN)
POST {{baseUrl}}/api/payments/{{reference}}/validate
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json

{
    "pin": "0000",
    "otp": "123456",
    "phone": "09021234567"
}

> {% client.global.set('status', response.body.action) %}
>>! {{$projectRoot}}/http/response/payment_validation_{{status}}.json

###
# @name Get single transaction
# Retrieve the full transaction record once it is completed or for status polling
GET {{baseUrl}}/api/transactions/{{reference}}
Authorization: Bearer {{apiKey}}
Accept: application/json

###
# @name Get current business
GET {{baseUrl}}/api/user
Authorization: Bearer {{apiKey}}
Accept: application/json

###
# @name Get Banks
GET {{base_url}}/api/utils/banks
Authorization: Bearer {{apiKey}}
Accept: application/json

###
# @name Register Recipient
# Register a bank account for transfers
POST {{baseUrl}}/api/recipients
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json

{
    "account_number": "0000000000",
    "bank_code": "058",
    "currency": "NGN"
}

> {% client.global.set('recipient_id', response.body.data.id) %}

###
# @name Initiate Transfer
# Create a new transfer request
POST {{baseUrl}}/api/transfers
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json

{
    "bank_account_id": {{recipient_id}},
    "amount": 50000,
    "reference": "transfer_{{$random.alphanumeric(10)}}",
    "metadata": {
        "reason": "Business settlement"
    }
}

> {% client.global.set('transfer_reference', response.body.data.reference) %}

###
# @name Authorize Transfer
# Finalize and send the transfer to the provider
POST {{baseUrl}}/api/transfers/{{transfer_reference}}/authorize
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json

{}


### Provider Webhook
# Simulate a webhook from a provider (e.g. Paystack)
# Note: You may need to disable CSRF or satisfy signature requirements for this to work locally.
POST {{baseUrl}}/api/webhooks/paystack
Content-Type: application/json
Accept: application/json

{
    "event": "charge.success",
    "data": {
        "reference": "{{reference}}",
        "status": "success",
        "amount": 500000,
        "customer": {
            "email": "customer@example.com"
        }
    }
}
